# ==============================================================
# MAHI AI - College AI Platform Global Configuration Example
# ==============================================================

# College Configuration
COLLEGE_NAME="MAHI Institute of Technology & Sciences"
COLLEGE_DOMAIN="mahi.edu"

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="MAHI AI"
NEXT_PUBLIC_COLLEGE_NAME="MAHI Institute of Technology & Sciences"

# Relational Database (PostgreSQL or SQLite fallback)
# For local dev without Postgres running, SQLite fallback is enabled:
DATABASE_URL=sqlite:///./mahi_ai.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://mahi_user:mahi_password@localhost:5432/mahi_db

# Local AI Engine (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# Vector Database (ChromaDB) & Embeddings
CHROMA_PERSIST_DIRECTORY=./data/chromadb
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Security & CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_V1_PREFIX=/api/v1
